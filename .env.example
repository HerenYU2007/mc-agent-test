# DeepSeek API 密钥配置 (可选，若在此填写则启动时自动读取)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_AUTO_START=0
MC_BOT_AUTOSTART=1

# Minecraft 服务器配置
MC_VERSION=1.21.11
MC_HOST=127.0.0.1
MC_PORT=25567
MC_USERNAME=NMO-TestAgent

# Web 监控端口。1.21.11 的 3D 画面使用 Fabric 旁观客户端
MC_VIEWER=0
MC_DASHBOARD_PORT=3001
